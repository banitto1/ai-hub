<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="local.aihub.mobile" android:versionCode="10" android:versionName="1.1.0">
 <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="36"/>
 <uses-permission android:name="android.permission.INTERNET"/>
 <application android:label="AI Hub" android:theme="@android:style/Theme.Material.NoActionBar" android:icon="@drawable/icon" android:allowBackup="false" android:usesCleartextTraffic="false" android:hardwareAccelerated="true">
  <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask" android:configChanges="orientation|screenSize|keyboardHidden" android:windowSoftInputMode="adjustResize">
   <intent-filter>
    <action android:name="android.intent.action.MAIN"/>
    <category android:name="android.intent.category.LAUNCHER"/>
   </intent-filter>
   <intent-filter>
    <action android:name="android.intent.action.VIEW"/>
    <category android:name="android.intent.category.DEFAULT"/>
    <category android:name="android.intent.category.BROWSABLE"/>
    <data android:scheme="aihub" android:host="pair"/>
   </intent-filter>
   <intent-filter>
    <action android:name="android.intent.action.SEND"/>
    <category android:name="android.intent.category.DEFAULT"/>
    <data android:mimeType="text/plain"/>
   </intent-filter>
  </activity>
 </application>
</manifest>
